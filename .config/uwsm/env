# Loaded by uwsm for Hyprland sessions only (Plasma isn't started through uwsm)
# Qt6 apps: theme via hyprqt6engine (config in ~/.config/hypr/hyprqt6engine.conf)
export QT_QPA_PLATFORMTHEME=hyprqt6engine
# Cursor (XCursor-based toolkits): Posy's Cursor Black, see ~/.dotfiles/.local/share/icons/README.md
export XCURSOR_THEME=posys_cursor_scalable_black
export XCURSOR_SIZE=24
# Input method: fcitx5. GTK/Qt6 Wayland apps talk to it through text-input-v3, so GTK_IM_MODULE
# stays unset; Qt prefers its Wayland IM and falls back to the fcitx module; X11 apps use XIM.
export XMODIFIERS=@im=fcitx
export QT_IM_MODULE=fcitx
export QT_IM_MODULES="wayland;fcitx"
# Toolkit backends: prefer native Wayland, fall back to X11 (from Caelestia's uwsm/env)
export ELECTRON_OZONE_PLATFORM_HINT=auto
export QT_QPA_PLATFORM="wayland;xcb"
export SDL_VIDEODRIVER=wayland,x11
# Java AWT/Swing apps (JetBrains IDEs etc.) draw blank grey windows under tiling compositors without this
export _JAVA_AWT_WM_NONREPARENTING=1
# Caelestia shell (fork in ~/.config/quickshell/caelestia): its C++ plugin and m3shapes are built into
# ~/.local (see the fork's FORK.md); QML modules there and the shell's helper binaries
export QML_IMPORT_PATH="$HOME/.local/lib/qt6/qml"
export CAELESTIA_LIB_DIR="$HOME/.local/lib/caelestia"
