{
    "appearance": {
        "font": {
            "mono": {
                "family": "Maple Mono NF"
            }
        }
    },
    "bar": {
        "activeWindow": {
            "inverted": true
        },
        "clock": {
            "showDate": true,
            "showIcon": true
        }
    },
    "general": {
        "apps": {
            "explorer": [
                "dolphin",
                "--select"
            ],
            "playback": [
                "dragon"
            ],
            "terminal": [
                "kitty"
            ]
        },
        "idle": {
            "timeouts": [
                {
                    "enabled": true,
                    "idleAction": "lock",
                    "inhibitWhenAudio": false,
                    "inhibitWhenCharging": false,
                    "respectInhibitors": true,
                    "timeout": 180
                },
                {
                    "enabled": true,
                    "idleAction": "dpms off",
                    "inhibitWhenAudio": false,
                    "inhibitWhenCharging": false,
                    "respectInhibitors": true,
                    "returnAction": "dpms on",
                    "timeout": 300
                }
            ]
        }
    },
    "paths": {
        "mediaGif": "",
        "sessionGif": "",
        "wallpaperDir": "~/.config/hypr/wallpaper"
    },
    "services": {
        "clockFormat": "TwelveHour",
        "dataUnits": "Decimal",
        "weatherUnits": "Celsius"
    }
}
