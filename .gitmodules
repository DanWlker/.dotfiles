[submodule "DanWlker/nvim.git"]
	path = .config/nvim
	url = https://github.com/DanWlker/nvim.git
[submodule ".tmux/plugins/tpm"]
	path = .tmux/plugins/tpm
	url = https://github.com/tmux-plugins/tpm
[submodule ".config/quickshell/caelestia"]
	path = .config/quickshell/caelestia
	url = https://github.com/DanWlker/caelestia-shell.git
[submodule ".zsh/plugins/powerlevel10k"]
	path = .zsh/plugins/powerlevel10k
	url = https://github.com/romkatv/powerlevel10k.git
	shallow = true
